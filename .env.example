# Choose a release with published GHCR images; v2.1.26 and older have ZIP assets only.
GSHARK_VERSION=
# For existing installations, use the CURRENT database root password.
MYSQL_ROOT_PASSWORD=
# Configure mysql.password and jwt.signing-key in server/config.docker.yaml.
# The application reads YAML; MYSQL_ROOT_PASSWORD does not override that file.
# Change to 0.0.0.0 only when LAN access is intended and protected by a firewall.
WEB_BIND_ADDRESS=127.0.0.1
WEB_PORT=8080
# Existing database image is intentionally unchanged. ARM64 fresh installs need
# a compatible MySQL image (or emulation); do not change existing DB versions blindly.
MYSQL_IMAGE=mysql/mysql-server:8.0.21
